    document.addEventListener('DOMContentLoaded', function() {
        const currentYear = new Date().getFullYear().toString().slice(-2);
        if(document.getElementById('klasaGodina')) document.getElementById('klasaGodina').value = currentYear;
        if(document.getElementById('urbrojGodina')) document.getElementById('urbrojGodina').value = currentYear;
        const currentDate = new Date();
        if(document.getElementById('datumOsnivanjaPredmeta')) document.getElementById('datumOsnivanjaPredmeta').valueAsDate = currentDate;
        if(document.getElementById('upDatumPrimitka')) document.getElementById('upDatumPrimitka').valueAsDate = currentDate;
