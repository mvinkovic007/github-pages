<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ePisarnica - Digitalno Upravljanje Predmetima</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary-blue: #0056b3; 
            --light-blue: #e6f0ff; 
            --dark-blue-text: #1a3a5a;
            --gray-bg: #f4f7fc;
            --light-gray-border: #d1d9e6;
            --medium-gray-text: #566573;
            --white: #ffffff;
            --sidebar-bg: #2c3e50; 
            --sidebar-text: #bdc3c7;
            --sidebar-active: #007bff; 
            --accent-green: #28a745;
            --accent-red: #dc3545;
            --status-otvoren: #ffc107;
            --status-urjesavanju: #17a2b8;
            --status-rijesen: #28a745;
            --status-arhiviran: #6c757d;
            --shadow-light: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            --shadow-medium: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            --card-bg: #ffffff;
            --card-border: #e0e6ed;
            --login-overlay-bg: rgba(0,0,0,0.75);
        }

        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--gray-bg);
            color: var(--dark-blue-text);
            display: flex;
            min-height: 100vh;
            box-sizing: border-box;
            overflow-x: hidden;
            font-size: 15px;
        }
        
        .app-container { display: none; width: 100%; }
        .login-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: var(--login-overlay-bg); display: flex; justify-content: center; align-items: center; z-index: 1000; }
        .login-box { background-color: var(--white); padding: 40px; border-radius: 8px; box-shadow: var(--shadow-medium); width: 380px; text-align: center; }
        .login-box h2 { color: var(--primary-blue); margin-bottom: 25px; font-family: 'Poppins', sans-serif; font-weight: 600; }
        .login-box .input-group { margin-bottom: 20px; text-align: left; }
        .login-box input[type="text"], .login-box input[type="password"] { width: calc(100% - 22px); padding: 10px; border: 1px solid var(--light-gray-border); border-radius: 5px; font-size: 0.95em; }
        .login-box button { width: 100%; margin-top: 10px; padding: 12px; background-color: var(--primary-blue); color: var(--white); border: none; border-radius: 5px; font-size: 1em; font-weight: 600; cursor: pointer; transition: background-color 0.2s ease; }
        .login-box button:hover { background-color: #004494; }
        .login-logo { font-family: 'Poppins', sans-serif; font-size: 2.2em; font-weight: 700; color: var(--primary-blue); margin-bottom: 10px; }
        .login-sublogo { font-size: 0.85em; color: var(--medium-gray-text); margin-bottom: 30px; }

        .app-layout { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; width: 100%; }
        .sidebar { background-color: var(--sidebar-bg); color: var(--sidebar-text); padding: 20px 0; box-shadow: var(--shadow-medium); display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
        .logo-section { padding: 0 20px 20px 20px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 20px; }
        .logo-text { font-family: 'Poppins', sans-serif; font-size: 1.8em; font-weight: 700; color: var(--white); line-height: 1.2; margin-bottom: 5px; }
        .logo-subtext { font-size: 0.7em; font-weight: 400; color: var(--sidebar-text); text-transform: uppercase; letter-spacing: 0.5px; }
        .sidebar-nav ul { list-style: none; padding: 0; margin: 0; }
        .sidebar-nav li a { display: flex; align-items: center; padding: 14px 20px; color: var(--sidebar-text); text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease; font-weight: 500; font-size: 0.98em; border-left: 3px solid transparent; }
        .sidebar-nav li a:hover { background-color: rgba(255, 255, 255, 0.08); color: var(--white); border-left: 3px solid var(--sidebar-active); }
        .sidebar-nav li.active a { background-color: var(--sidebar-active); color: var(--white); font-weight: 600; border-left: 3px solid var(--white); }
        .sidebar-nav li a i { margin-right: 12px; font-size: 1.1em; width: 20px; text-align: center; color: var(--sidebar-text); }
        .sidebar-nav li.active a i { color: var(--white); }
        .sidebar-nav .nav-group-title { padding: 10px 20px 5px; font-size: 0.75em; font-weight: 600; color: #95a5a6; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 15px; }

        .main-content-wrapper { padding: 30px; background-color: var(--gray-bg); overflow-y: auto; }
        .page-header { background-color: var(--white); border-radius: 8px; box-shadow: var(--shadow-light); padding: 20px 30px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
        .page-header h1 { margin: 0; font-family: 'Poppins', sans-serif; font-size: 1.8em; font-weight: 600; color: var(--dark-blue-text); }
        .page-header .user-info { font-size: 0.9em; color: var(--medium-gray-text); }
        #loggedInUser { font-weight: 600; color: var(--dark-blue-text); }

        .content-card { background-color: var(--card-bg); padding: 30px; border-radius: 8px; box-shadow: var(--shadow-light); margin-bottom: 30px; border: 1px solid var(--card-border); display: none; }
        .content-card.active-section { display: block; }
        h2 { font-family: 'Poppins', sans-serif; color: var(--primary-blue); border-bottom: 2px solid var(--primary-blue); padding-bottom: 12px; margin-top: 0; margin-bottom: 25px; font-size: 1.6em; font-weight: 600; }
        h3 { font-family: 'Poppins', sans-serif; color: var(--dark-blue-text); margin-top: 20px; margin-bottom: 15px; font-size: 1.3em; font-weight: 500; }
        .input-group { margin-bottom: 18px; }
        .input-group.inline { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; align-items: flex-end; }
        label { display: block; margin-bottom: 6px; font-weight: 500; color: var(--medium-gray-text); font-size: 0.9em; }
        input[type="text"], input[type="number"], input[type="date"], input[type="email"], select, textarea { width: 100%; padding: 10px; border: 1px solid var(--light-gray-border); border-radius: 5px; font-size: 0.95em; box-sizing: border-box; transition: border-color 0.2s ease, box-shadow 0.2s ease; font-family: 'Montserrat', sans-serif; }
        input[type="text"]:focus, input[type="number"]:focus, input[type="date"]:focus, input[type="email"]:focus, select:focus, textarea:focus { border-color: var(--primary-blue); box-shadow: 0 0 0 0.15rem rgba(0, 86, 179, 0.25); outline: none; }
        button, .btn { display: inline-block; padding: 10px 18px; background-color: var(--accent-green); color: var(--white); border: none; border-radius: 5px; font-size: 0.95em; font-weight: 600; cursor: pointer; transition: background-color 0.2s ease, transform 0.1s ease; margin-top: 10px; margin-right: 10px; box-shadow: var(--shadow-light); }
        button:last-child { margin-right: 0; }
        button:hover, .btn:hover { transform: translateY(-1px); }
        button.primary, .btn.primary { background-color: var(--primary-blue); }
        button.primary:hover, .btn.primary:hover { background-color: #004494; }
        button.secondary, .btn.secondary { background-color: var(--medium-gray-text); }
        button.secondary:hover, .btn.secondary:hover { background-color: #5a6268; }
        button.danger, .btn.danger { background-color: var(--accent-red); }
        button.danger:hover, .btn.danger:hover { background-color: #c82333; }

        .result-section { margin-top: 30px; padding: 20px; border: 1px solid var(--primary-blue); border-radius: 8px; background-color: var(--light-blue); box-shadow: var(--shadow-light); }
        .result-item { margin-bottom: 12px; }
        .result-item:last-child { margin-bottom: 0; }
        .result-label { font-weight: 600; color: var(--dark-blue-text); display: block; margin-bottom: 4px; font-size: 0.85em; }
        .result-value { background-color: var(--white); padding: 8px 10px; border: 1px solid var(--light-gray-border); border-radius: 4px; word-wrap: break-word; white-space: pre-wrap; font-family: 'Poppins', monospace; font-size: 0.9em; color: var(--dark-blue-text); min-height: 1.2em; }
        .status-badge { padding: 4px 10px; border-radius: 15px; color: var(--white); font-size: 0.8em; font-weight: 500; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px; }
        .status-otvoren { background-color: var(--status-otvoren); color: #333; }
        .status-urjesavanju { background-color: var(--status-urjesavanju); }
        .status-rijesen { background-color: var(--status-rijesen); }
        .status-arhiviran { background-color: var(--status-arhiviran); }

        .case-cover-simulation { border: 1px solid var(--light-gray-border); padding: 30px; margin-top: 30px; background-color: #fafcff; border-radius: 8px; box-shadow: var(--shadow-light); font-family: 'Times New Roman', Times, serif; font-size: 12pt; color: #333; }
        .case-cover-simulation p { margin: 12px 0; line-height: 1.6; }
        .case-cover-simulation .line { border-bottom: 1px solid #999; padding-bottom: 2px; margin-top: 2px; display: inline-block; min-width: 200px; min-height: 1.3em; font-weight: bold; }
        .case-cover-simulation .body-name { font-size: 11pt; color: var(--medium-gray-text); text-align: right; margin-bottom: 25px; font-style: italic; }
        .case-cover-simulation .footer-info { margin-top: 50px; font-size: 9pt; color: #777; text-align: center; }
        #simulacijaKlasifikacijskaOmot { font-weight: bold; color: var(--dark-blue-text); }
        #simulacijaPredmetOmot { font-style: italic; }

        .placeholder-text { color: var(--medium-gray-text); font-style: italic; text-align: center; padding: 40px; border: 2px dashed var(--light-gray-border); border-radius: 8px; background-color: #fdfdfd; }
        
        .data-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.9em; }
        .data-table th, .data-table td { border: 1px solid var(--light-gray-border); padding: 8px 10px; text-align: left; }
        .data-table th { background-color: #e9ecef; font-weight: 600; color: var(--medium-gray-text); }
        .data-table tbody tr:nth-child(even) { background-color: #f8f9fa; }
        .data-table tbody tr:hover { background-color: #e6f0ff; }
        
        .stamp-simulation { border: 2px dashed var(--primary-blue); padding: 15px; margin-top: 20px; background-color: var(--light-blue); border-radius: 5px; font-family: 'Courier New', Courier, monospace; font-size: 0.9em; line-height: 1.5; }
        .stamp-simulation h4 { text-align: center; margin-top: 0; margin-bottom: 10px; font-family: 'Poppins', sans-serif; color: var(--primary-blue); border-bottom: 1px solid var(--primary-blue); padding-bottom: 5px; }
        .stamp-simulation p { margin: 4px 0; }
        .stamp-simulation strong { display: inline-block; min-width: 100px; }

        .envelope-simulation .sender-info { text-align: left; font-size: 0.8em; margin-bottom: 20px; }
        .envelope-simulation .recipient-info { text-align: center; font-size: 1em; padding: 10px; border: 1px solid var(--dark-blue-text); margin: 0 auto; max-width: 280px; }


        @media (max-width: 992px) { .app-layout {grid-template-columns: 1fr;} .sidebar {display: none;} .main-content-wrapper {padding: 20px;} }
        @media (max-width: 768px) { .login-box { width: 90%; padding: 30px;} .content-card {padding: 20px;} .page-header h1 { font-size: 1.5em; } h2 { font-size: 1.4em; } .input-group.inline { grid-template-columns: 1fr; } .case-cover-simulation { font-size: 11pt; padding: 20px; } .case-cover-simulation .line { min-width: 150px; } }
    </style>
</head>
<body>
    <div class="login-overlay" id="loginOverlay">
        <div class="login-box">
            <div class="login-logo">ePisarnica</div>
            <div class="login-sublogo">Sustav za digitalno uredsko poslovanje</div>
            <h2>Prijava korisnika</h2>
            <div class="input-group">
                <label for="username">Korisničko ime:</label>
                <input type="text" id="username" value="referent01">
            </div>
            <div class="input-group">
                <label for="password">Lozinka:</label>
                <input type="password" id="password" value="ured123">
            </div>
            <button onclick="handleLogin()">Prijavi se</button>
        </div>
    </div>

    <div class="app-container" id="appContainer">
        <div class="app-layout">
            <div class="sidebar no-print">
                 <div class="logo-section">
                    <div class="logo-text">ePisarnica</div>
                    <div class="logo-subtext">Digitalno uredsko poslovanje</div>
                </div>
                <nav class="sidebar-nav">
                    <ul>
                        <div class="nav-group-title">Predmeti</div>
                        <li class="active"><a href="#osnivanje-predmeta-sekcija"><i class="fas fa-file-medical"></i> Osnivanje predmeta</a></li>
                        <li><a href="#pregled-predmeta-sekcija"><i class="fas fa-folder-open"></i> Pregled predmeta</a></li>
                        <li><a href="#sadrzaj-predmeta-sekcija"><i class="fas fa-file-alt"></i> Sadržaj predmeta</a></li>
                        <li><a href="#omot-spisa-sekcija"><i class="fas fa-folder"></i> Omot spisa</a></li>

                        <div class="nav-group-title">Pošta</div>
                        <li><a href="#ulazna-posta-sekcija"><i class="fas fa-envelope-open-text"></i> Knjiga ulazne pošte</a></li>
                        <li><a href="#izlazna-posta-sekcija"><i class="fas fa-paper-plane"></i> Knjiga izlazne pošte</a></li>
                        
                        <div class="nav-group-title">Pismena</div>
                        <li><a href="#pismena-sekcija"><i class="fas fa-edit"></i> Pismena (Podnesci/Akti)</a></li>
                        
                        <div class="nav-group-title">Administracija i Alati</div>
                        <li><a href="#plan-klasifikacije-sekcija"><i class="fas fa-sitemap"></i> Plan klas. oznaka</a></li>
                        <li><a href="#zadaci-kretaljka-sekcija"><i class="fas fa-tasks"></i> Zadaci i Kretaljka</a></li>
                        <li><a href="#statistika-sekcija"><i class="fas fa-chart-bar"></i> Statistika rješavanja</a></li>
                        <li><a href="#izvjestaji-analiza-sekcija"><i class="fas fa-chart-line"></i> Izvještaji i Analiza</a></li>
                        <li><a href="#administracija-korisnika-sekcija"><i class="fas fa-users-cog"></i> Administracija sustava</a></li>

                        <div class="nav-group-title">Napredno</div>
                        <li><a href="#epotpis-sekcija"><i class="fas fa-signature"></i> Elektroničko potpisivanje</a></li>
                        <li><a href="#portal-stranke-sekcija"><i class="fas fa-globe"></i> Portal za stranke</a></li>
                        
                        <div class="nav-group-title" style="margin-top: 30px;">Korisnik</div>
                        <li><a href="#" onclick="handleLogout()"><i class="fas fa-sign-out-alt"></i> Odjava</a></li>
                    </ul>
                </nav>
            </div>

            <div class="main-content-wrapper">
                <div class="page-header no-print">
                    <h1 id="pageTitle">Osnivanje novog predmeta</h1>
                    <div class="user-info">Prijavljeni korisnik: <span id="loggedInUser"></span></div>
                </div>

                <div class="content-card active-section" id="osnivanje-predmeta-sekcija">
                    <h2>Osnivanje novog predmeta</h2>
                    <div class="input-group">
                        <label for="nazivTijela">Naziv javnopravnog tijela:</label>
                        <input type="text" id="nazivTijela" value="Gradski ured za opću upravu">
                    </div>
                    <div class="input-group inline">
                        <div>
                            <label for="statusPredmeta">Status predmeta:</label>
                            <select id="statusPredmeta" onchange="generirajOznake()">
                                <option value="Otvoren" data-class="status-otvoren" selected>Otvoren</option>
                                <option value="U rješavanju" data-class="status-urjesavanju">U rješavanju</option>
                                <option value="Riješen" data-class="status-rijesen">Riješen</option>
                                <option value="Arhiviran" data-class="status-arhiviran">Arhiviran</option>
                            </select>
                        </div>
                        <div>
                            <label for="datumOsnivanjaPredmeta">Datum osnivanja predmeta:</label>
                            <input type="date" id="datumOsnivanjaPredmeta" onchange="generirajOznake()">
                        </div>
                    </div>

                    <h3>Klasifikacijska oznaka (KLASA)</h3>
                    <div class="input-group inline">
                        <div>
                            <label for="vrstaPostupka">Vrsta postupka:</label>
                            <select id="vrstaPostupka" onchange="generirajOznake()">
                                <option value="">Nije upravni postupak</option>
                                <option value="UP/I">UP/I (Prvostupanjski)</option>
                                <option value="UP/II">UP/II (Drugostupanjski)</option>
                            </select>
                        </div>
                        <div>
                            <label for="oznakaUstrojstveneJediniceOmot">Ustrojstvena jedinica (za omot):</label>
                            <select id="oznakaUstrojstveneJediniceOmot" onchange="generirajOznake()"></select>
                        </div>
                    </div>
                    <div class="input-group inline">
                        <div>
                            <label for="klasaGlavnaGrupa">Glavna grupa:</label>
                            <select id="klasaGlavnaGrupa" onchange="populateGrupa(); generirajOznake();"></select>
                        </div>
                        <div>
                            <label for="klasaGrupa">Grupa:</label>
                            <select id="klasaGrupa" onchange="populatePodgrupa(); generirajOznake();"></select>
                        </div>
                    </div>
                    <div class="input-group inline">
                        <div>
                            <label for="klasaPodgrupa">Podgrupa:</label>
                            <select id="klasaPodgrupa" onchange="populateDjelatnost(); generirajOznake();"></select>
                        </div>
                        <div>
                            <label for="klasaDjelatnost">Djelatnost unutar podgrupe:</label>
                            <select id="klasaDjelatnost" onchange="generirajOznake()"></select>
                        </div>
                    </div>
                    <div class="input-group inline">
                        <div>
                            <label for="klasaGodina">Godina (npr. 24):</label>
                            <input type="text" id="klasaGodina" maxlength="2" placeholder="24" oninput="generirajOznake()">
                        </div>
                        <div>
                            <label for="klasaOblik">Oznaka dosjea/Oblik (npr. 01):</label>
                            <input type="text" id="klasaOblik" placeholder="01 (ako postoji)" oninput="generirajOznake()">
                        </div>
                        <div>
                            <label for="klasaRedniBrojPredmeta">Redni broj predmeta:</label>
                            <input type="number" id="klasaRedniBrojPredmeta" value="1" min="1" oninput="generirajOznake()">
                        </div>
                    </div>

                    <h3>Urudžbeni broj (URBROJ) - za akte</h3>
                     <div class="input-group inline">
                        <div>
                            <label for="urbrojOznakaTijela">Brojčana oznaka tijela:</label>
                            <input type="text" id="urbrojOznakaTijela" value="2100" title="Jedinstvena brojčana oznaka dodijeljena javnopravnom tijelu" oninput="generirajOznake()">
                        </div>
                        <div>
                            <label for="urbrojOUJ">Ustrojstvena jedinica (URBROJ):</label>
                            <select id="urbrojOUJ" onchange="generirajOznake()"></select>
                        </div>
                    </div>
                    <div class="input-group inline">
                        <div>
                            <label for="urbrojSluzbenaOsoba">Službena osoba (npr. 01):</label>
                            <input type="text" id="urbrojSluzbenaOsoba" placeholder="01 (ako postoji)" oninput="generirajOznake()">
                        </div>
                        <div>
                            <label for="urbrojGodina">Godina akta (npr. 24):</label>
                            <input type="text" id="urbrojGodina" maxlength="2" placeholder="24" oninput="generirajOznake()">
                        </div>
                        <div>
                            <label for="urbrojRedniBrojPismena">Redni broj pismena (u predmetu):</label>
                            <input type="number" id="urbrojRedniBrojPismena" value="1" min="1" oninput="generirajOznake()">
                        </div>
                    </div>
                    
                    <div class="input-group">
                        <label for="predmetOpis">Kratak opis predmeta (za polje "Predmet"):</label>
                        <textarea id="predmetOpis" rows="3" placeholder="Unesite kratak i jasan opis predmeta..." oninput="generirajOznake()"></textarea>
                    </div>
                     <div class="input-group">
                        <label for="strankaPredmeta">Stranka u predmetu (ako postoji):</label>
                        <input type="text" id="strankaPredmeta" placeholder="Npr. Ime Prezime, Adresa" oninput="generirajOznake()">
                    </div>

                    <button onclick="generirajOznake(true)" class="primary"><i class="fas fa-cogs"></i> Generiraj/Ažuriraj Oznake i Spremi Predmet</button>

                    <div class="result-section">
                        <h3>Generirani podaci za Predmet</h3>
                        <div class="result-item">
                            <span class="result-label">Klasifikacijska oznaka (KLASA):</span>
                            <div id="klasifikacijskaOznakaResult" class="result-value"></div>
                        </div>
                        <div class="result-item">
                            <span class="result-label">Urudžbeni broj (URBROJ) - za prvi akt:</span>
                            <div id="urBrojResult" class="result-value"></div>
                        </div>
                        <div class="result-item">
                            <span class="result-label">Predmet (opis):</span>
                            <div id="predmetResult" class="result-value"></div>
                        </div>
                         <div class="result-item">
                            <span class="result-label">Stranka:</span>
                            <div id="strankaResult" class="result-value"></div>
                        </div>
                        <div class="result-item">
                            <span class="result-label">Status predmeta:</span>
                            <div id="statusPredmetaResult" class="result-value"></div>
                        </div>
                    </div>
                </div>
                
                <div class="content-card" id="ulazna-posta-sekcija">
                    <h2>Knjiga ulazne pošte</h2>
                    <h3>Novi unos u knjigu ulazne pošte</h3>
                    <div class="input-group inline">
                        <div>
                            <label for="upDatumPrimitka">Datum primitka:</label>
                            <input type="date" id="upDatumPrimitka">
                        </div>
                        <div>
                            <label for="upPosiljatelj">Pošiljatelj:</label>
                            <input type="text" id="upPosiljatelj" placeholder="Naziv ili Ime i Prezime">
                        </div>
                    </div>
                    <div class="input-group">
                        <label for="upAdresaPosiljatelja">Adresa pošiljatelja:</label>
