        if(document.getElementById('klasaPodgrupa')) document.getElementById('klasaPodgrupa').innerHTML = '<option value="">-- Odaberite --</option>';
        if(document.getElementById('klasaDjelatnost')) document.getElementById('klasaDjelatnost').innerHTML = '<option value="">-- Odaberite --</option>';

        if (glavnaGrupaCode && DATA_KLASIFIKACIJA[glavnaGrupaCode] && DATA_KLASIFIKACIJA[glavnaGrupaCode].groups) {
            for (const grupaCode in DATA_KLASIFIKACIJA[glavnaGrupaCode].groups) {
                const grupaObj = DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode];
                const optionText = `${grupaCode} - ${grupaObj.name || 'Nepoznata podgrupa'}`;
                select.add(new Option(optionText, grupaCode));
            }
        }
        populatePodgrupa();
    }
    function populatePodgrupa() { /* ... ostaje isto ... */ 
        const glavnaGrupaCode = document.getElementById('klasaGlavnaGrupa').value;
        const grupaCode = document.getElementById('klasaGrupa').value;
        const select = document.getElementById('klasaPodgrupa');
        if(!select) return;
        select.innerHTML = '<option value="">-- Odaberite --</option>';
        if(document.getElementById('klasaDjelatnost')) document.getElementById('klasaDjelatnost').innerHTML = '<option value="">-- Odaberite --</option>';

        if (glavnaGrupaCode && grupaCode && 
            DATA_KLASIFIKACIJA[glavnaGrupaCode] && DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode] &&
            DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups) {
            for (const podgrupaCode in DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups) {
                const podgrupaObj = DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups[podgrupaCode];
                const optionText = `${podgrupaCode} - ${podgrupaObj.name || 'Nepoznata podgrupa'}`;
                select.add(new Option(optionText, podgrupaCode));
            }
        }
        populateDjelatnost();
    }
    function populateDjelatnost() { /* ... ostaje isto ... */ 
        const glavnaGrupaCode = document.getElementById('klasaGlavnaGrupa').value;
        const grupaCode = document.getElementById('klasaGrupa').value;
        const podgrupaCode = document.getElementById('klasaPodgrupa').value;
        const select = document.getElementById('klasaDjelatnost');
        if(!select) return;
        select.innerHTML = '<option value="">-- Odaberite --</option>';

        if (glavnaGrupaCode && grupaCode && podgrupaCode &&
            DATA_KLASIFIKACIJA[glavnaGrupaCode] && DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode] &&
            DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups[podgrupaCode] &&
            DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups[podgrupaCode].activities) {
            for (const djelatnostCode in DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups[podgrupaCode].activities) {
                const djelatnostText = DATA_KLASIFIKACIJA[glavnaGrupaCode].groups[grupaCode].subgroups[podgrupaCode].activities[djelatnostCode];
                const optionText = `${djelatnostCode} - ${djelatnostText}`;
                select.add(new Option(optionText, djelatnostCode));
            }
        }
    }

    function generirajOznake(spremiPredmet = false) {
        const nazivTijela = document.getElementById('nazivTijela').value.trim();
        const statusPredmetaElement = document.getElementById('statusPredmeta');
        const statusPredmetaValue = statusPredmetaElement.value;
        const statusPredmetaClass = statusPredmetaElement.selectedOptions[0].dataset.class;
        const datumOsnivanja = document.getElementById('datumOsnivanjaPredmeta').value;
        const stranka = document.getElementById('strankaPredmeta').value.trim();

        const vrstaPostupka = document.getElementById('vrstaPostupka').value;
        const oznakaUstrojstveneJediniceOmot = document.getElementById('oznakaUstrojstveneJediniceOmot').value;
        const oznakaUstrojstveneJediniceOmotText = document.getElementById('oznakaUstrojstveneJediniceOmot').selectedIndex > 0 ? document.getElementById('oznakaUstrojstveneJediniceOmot').options[document.getElementById('oznakaUstrojstveneJediniceOmot').selectedIndex].text : '[Nije odabrano]';

        const klasaGlavnaGrupa = document.getElementById('klasaGlavnaGrupa').value;
        const klasaGrupa = document.getElementById('klasaGrupa').value;
        const klasaPodgrupa = document.getElementById('klasaPodgrupa').value;
        const klasaDjelatnost = document.getElementById('klasaDjelatnost').value;
        const klasaGodina = document.getElementById('klasaGodina').value.trim() || new Date().getFullYear().toString().slice(-2);
        const klasaOblik = document.getElementById('klasaOblik').value.trim();
        const klasaRedniBrojPredmeta = document.getElementById('klasaRedniBrojPredmeta').value.trim() || '1';

        const urbrojOznakaTijela = document.getElementById('urbrojOznakaTijela').value.trim();
        const urbrojOUJ = document.getElementById('urbrojOUJ').value;
        const urbrojSluzbenaOsoba = document.getElementById('urbrojSluzbenaOsoba').value.trim();
        const urbrojGodina = document.getElementById('urbrojGodina').value.trim() || new Date().getFullYear().toString().slice(-2);
        const urbrojRedniBrojPismena = document.getElementById('urbrojRedniBrojPismena').value.trim() || '1';
        
        const predmetOpis = document.getElementById('predmetOpis').value.trim();

        let finalKlasifikacijskaOznaka = "";
        if (klasaGlavnaGrupa && klasaGrupa && klasaPodgrupa && klasaDjelatnost) {
            if (vrstaPostupka) finalKlasifikacijskaOznaka += `${vrstaPostupka} `;
            finalKlasifikacijskaOznaka += `KLASA: ${klasaGlavnaGrupa}${klasaGrupa}${klasaPodgrupa}-${klasaDjelatnost}`;
            finalKlasifikacijskaOznaka += `/${klasaGodina}`;
            if (klasaOblik) finalKlasifikacijskaOznaka += `-${klasaOblik}`;
            finalKlasifikacijskaOznaka += `/${klasaRedniBrojPredmeta}`;
        } else {
            finalKlasifikacijskaOznaka = "[Nisu odabrani svi elementi klasifikacije]";
        }

        let urBroj = "";
        if (urbrojOznakaTijela) {
            urBroj = `URBROJ: ${urbrojOznakaTijela}`;
            if (urbrojOUJ) urBroj += `-${urbrojOUJ}`;
            if (urbrojSluzbenaOsoba) urBroj += `/${urbrojSluzbenaOsoba}`;
            urBroj += `-${urbrojGodina}-${urbrojRedniBrojPismena}`;
        } else {
            urBroj = "[Nije definirana oznaka tijela za URBROJ]";
        }

        document.getElementById('klasifikacijskaOznakaResult').textContent = finalKlasifikacijskaOznaka;
        document.getElementById('urBrojResult').textContent = urBroj;
        document.getElementById('predmetResult').textContent = predmetOpis || "[Nije unesen opis predmeta]";
        document.getElementById('strankaResult').textContent = stranka || "[Nije unesena]";
        document.getElementById('statusPredmetaResult').innerHTML = `<span class="status-badge ${statusPredmetaClass}">${statusPredmetaValue}</span>`;

        document.getElementById('simulacijaNazivTijelaOmot').textContent = nazivTijela || "[Naziv tijela]";
        document.getElementById('simulacijaUstrojstvenaOmot').textContent = oznakaUstrojstveneJediniceOmotText;
        
        let klasaZaOmot = "";
        if (klasaGlavnaGrupa && klasaGrupa && klasaPodgrupa && klasaDjelatnost) {
             klasaZaOmot = `${klasaGlavnaGrupa}${klasaGrupa}${klasaPodgrupa}-${klasaDjelatnost}/${klasaGodina}`;
             if (klasaOblik) klasaZaOmot += `-${klasaOblik}`;
             klasaZaOmot += `/${klasaRedniBrojPredmeta}`;
             if (vrstaPostupka) klasaZaOmot = `${vrstaPostupka} ${klasaZaOmot}`;
        } else {
            klasaZaOmot = "[Nisu odabrani svi elementi klasifikacije]";
        }
        document.getElementById('simulacijaKlasifikacijskaOmot').textContent = klasaZaOmot;
        document.getElementById('simulacijaPredmetOmot').textContent = predmetOpis || "[Nije unesen opis predmeta]";
        document.getElementById('simulacijaStatusPredmetaOmot').innerHTML = `<span class="status-badge ${statusPredmetaClass}">${statusPredmetaValue}</span>`;

        if(spremiPredmet){
            trenutniPredmetPodaci = {
                nazivTijela, statusPredmetaValue, statusPredmetaClass, datumOsnivanja, stranka,
                klasa: finalKlasifikacijskaOznaka,
                urbroj: urBroj, // Osnovni URBROJ za predmet (prvi akt)
                opis: predmetOpis,
                pismena: [],
                dogadaji: []
            };
            pismenaZaTrenutniPredmet = [];
            dogadajiZaTrenutniPredmet = [];
            pismenaCounter = 1;
            dogadajiCounter = 1;
            alert("Podaci o predmetu su spremljeni i postavljeni kao trenutno aktivni.");
            azurirajPrikazSadrzajaPredmeta(); // Odmah ažuriraj prikaz
        }
    }
    
    function azurirajPrikazSadrzajaPredmeta() {
        if (trenutniPredmetPodaci) {
            document.getElementById('spInfoKlasa').textContent = trenutniPredmetPodaci.klasa;
            document.getElementById('spInfoUrbroj').textContent = trenutniPredmetPodaci.urbroj;
            document.getElementById('spInfoOpis').textContent = trenutniPredmetPodaci.opis;
            document.getElementById('spInfoStranka').textContent = trenutniPredmetPodaci.stranka || "N/A";
            document.getElementById('spInfoStatus').className = `status-badge ${trenutniPredmetPodaci.statusPredmetaClass}`;
            document.getElementById('spInfoStatus').textContent = trenutniPredmetPodaci.statusPredmetaValue;
        } else {
            document.getElementById('spInfoKlasa').textContent = "Nije odabran/kreiran predmet";
            document.getElementById('spInfoUrbroj').textContent = "N/A";
            document.getElementById('spInfoOpis').textContent = "N/A";
            document.getElementById('spInfoStranka').textContent = "N/A";
            document.getElementById('spInfoStatus').className = "status-badge";
            document.getElementById('spInfoStatus').textContent = "N/A";
        }
        renderPopisPismena();
        renderDogadajiNaPredmetu();
    }

    // --- Funkcije za Knjigu ulazne pošte ---
    function dodajUlaznuPostu() {
        const datumPrimitka = document.getElementById('upDatumPrimitka').value;
        const posiljatelj = document.getElementById('upPosiljatelj').value.trim();
        const adresaPosiljatelja = document.getElementById('upAdresaPosiljatelja').value.trim();
        const sadrzajPismena = document.getElementById('upSadrzajPismena').value.trim();
        const vezaNaPredmet = document.getElementById('upVezaNaPredmet').value.trim();
        const brojPriloga = document.getElementById('upBrojPriloga').value;
        const primilaJedinica = document.getElementById('upPrimilaJedinica').value;
        const primilaJedinicaText = document.getElementById('upPrimilaJedinica').selectedIndex > 0 ? document.getElementById('upPrimilaJedinica').options[document.getElementById('upPrimilaJedinica').selectedIndex].text : '[Nije odabrano]';
        const primioPotpis = document.getElementById('upPrimioPotpis').value;

        if (!datumPrimitka || !posiljatelj || !sadrzajPismena || !primilaJedinica) {
            alert("Molimo popunite obavezna polja: Datum primitka, Pošiljatelj, Sadržaj, Primila jedinica.");
            return;
        }

        const noviUnos = {
            rbr: ulaznaPostaCounter++,
            datumPrimitka, posiljatelj, adresaPosiljatelja, sadrzajPismena, vezaNaPredmet, brojPriloga, primilaJedinicaText, primioPotpis,
            jop: `JOP-${new Date().getFullYear()}-${String(Math.random()).slice(2, 8)}` // Jednostavna simulacija JOP-a
        };
        evidencijaUlaznePoste.unshift(noviUnos); // Dodaj na početak niza
        renderUlaznaPostaTable();
        // Opcionalno: očisti formu
        document.getElementById('upPosiljatelj').value = '';
        document.getElementById('upAdresaPosiljatelja').value = '';
        document.getElementById('upSadrzajPismena').value = '';
        document.getElementById('upVezaNaPredmet').value = '';
        document.getElementById('upBrojPriloga').value = '0';
    }

    function renderUlaznaPostaTable() {
        const tbody = document.getElementById('ulaznaPostaTable').getElementsByTagName('tbody')[0];
        tbody.innerHTML = ""; // Očisti postojeće unose
        evidencijaUlaznePoste.forEach(unos => {
            const row = tbody.insertRow();
            row.insertCell().textContent = unos.rbr;
            row.insertCell().textContent = new Date(unos.datumPrimitka).toLocaleDateString('hr-HR');
            row.insertCell().textContent = unos.posiljatelj;
            row.insertCell().textContent = unos.sadrzajPismena;
            row.insertCell().textContent = unos.vezaNaPredmet;
            row.insertCell().textContent = unos.brojPriloga;
            row.insertCell().textContent = unos.primioPotpis;
        });
    }
    
    function generirajPrijemniStampiljPreview() {
        const nazivTijela = document.getElementById('nazivTijela').value.trim();
        const orgJedinicaSelect = document.getElementById('upPrimilaJedinica');
        const orgJedinicaText = orgJedinicaSelect.selectedIndex > 0 ? orgJedinicaSelect.options[orgJedinicaSelect.selectedIndex].text : '[Nije odabrano]';
        const datumPrimitka = document.getElementById('upDatumPrimitka').value ? new Date(document.getElementById('upDatumPrimitka').value).toLocaleDateString('hr-HR') : '[Datum]';
        const veza = document.getElementById('upVezaNaPredmet').value.trim() || '[Nema veze]';
        const prilozi = document.getElementById('upBrojPriloga').value || '0';
        
        // Simulacija JOP-a - Jedinstvena Oznaka Pismena
        const jop = `JOP-${new Date().getFullYear()}-${String(Math.random()).slice(2, 10)}`;


        document.getElementById('stampDatum').textContent = datumPrimitka;
        document.getElementById('stampTijelo').textContent = nazivTijela || '[Naziv Tijela]';
        document.getElementById('stampOrgJed').textContent = orgJedinicaText;
        // Za KLASA i URBROJ iz veze, treba parsirati string 'veza'
        // Ovo je pojednostavljeno, stvarna implementacija bi trebala bolje parsirati
        let klasaVezaStamp = veza.includes("KLASA:") ? veza.split("KLASA:")[1].split(",")[0].trim() : veza;
        let urbrojVezaStamp = veza.includes("URBROJ:") ? veza.split("URBROJ:")[1].trim() : "-";
        document.getElementById('stampKlasa').textContent = klasaVezaStamp;
        document.getElementById('stampUrbroj').textContent = urbrojVezaStamp;
        document.getElementById('stampPrilozi').textContent = prilozi;
        document.getElementById('stampJOP').textContent = jop;

        document.getElementById('prijemniStampiljPreview').style.display = 'block';
    }


