        loggedInUsername = '';
        document.getElementById('loginOverlay').style.display = 'flex';
        document.getElementById('appContainer').style.display = 'none';
        document.getElementById('username').value = '';
        document.getElementById('password').value = '';
    }
    function setActiveSection(targetId) { /* ... ostaje isto ... */ 
        document.querySelectorAll('.content-card').forEach(card => card.classList.remove('active-section'));
        const activeCard = document.getElementById(targetId);
        if (activeCard) activeCard.classList.add('active-section');

        document.querySelectorAll('.sidebar-nav li').forEach(li => li.classList.remove('active'));
        const activeLink = document.querySelector(`.sidebar-nav a[href="#${targetId}"]`);
        if (activeLink && activeLink.parentElement) activeLink.parentElement.classList.add('active');
        
        const mainContent = document.querySelector('.main-content-wrapper');
        if (mainContent) mainContent.scrollTop = 0;

        if (targetId === 'sadrzaj-predmeta-sekcija') {
            azurirajPrikazSadrzajaPredmeta();
        }
    }

    function populateUstrojstveneJedinice() { /* ... ostaje isto ... */ 
        const selectOmot = document.getElementById('oznakaUstrojstveneJediniceOmot');
        const selectUrbroj = document.getElementById('urbrojOUJ');
        const selectUpPrimila = document.getElementById('upPrimilaJedinica');

        const selects = [selectOmot, selectUrbroj, selectUpPrimila].filter(s => s); // Filtriraj null vrijednosti

        selects.forEach(select => {
            select.innerHTML = select.id === 'urbrojOUJ' ? 
                '<option value="">-- Nije definirano (opcionalno) --</option>' : 
                '<option value="">-- Odaberite --</option>';
            for (const key in DATA_USTROJSTVENE_JEDINICE) {
                const optionText = `${key} - ${DATA_USTROJSTVENE_JEDINICE[key]}`;
                select.add(new Option(optionText, key));
            }
        });
         // Postavi default za ulaznu poštu ako postoji "02 - OPĆA UPRAVA"
        if (selectUpPrimila && DATA_USTROJSTVENE_JEDINICE["02"]) {
            selectUpPrimila.value = "02";
        }
