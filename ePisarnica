    // --- Funkcije za Sadržaj predmeta (Popis pismena i Događaji) ---
    function dodajPismenoUPredmet() {
        if (!trenutniPredmetPodaci) {
            alert("Nije kreiran ili odabran predmet. Molimo prvo osnujte predmet.");
            return;
        }
        const datum = document.getElementById('novoPismenoDatum').value;
        const vrstaOpis = document.getElementById('novoPismenoVrsta').value.trim();
        const prilozi = document.getElementById('novoPismenoPrilozi').value;

        if (!datum || !vrstaOpis) {
            alert("Molimo unesite datum i vrstu/opis pismena.");
            return;
        }
        pismenaZaTrenutniPredmet.push({
            rbr: pismenaCounter++,
            datum, vrstaOpis, prilozi
        });
        renderPopisPismena();
        document.getElementById('novoPismenoVrsta').value = '';
        document.getElementById('novoPismenoPrilozi').value = '0';
    }
    function renderPopisPismena() {
        const tbody = document.getElementById('popisPismenaTable').getElementsByTagName('tbody')[0];
        tbody.innerHTML = "";
        pismenaZaTrenutniPredmet.forEach(pismeno => {
            const row = tbody.insertRow();
            row.insertCell().textContent = pismeno.rbr;
            row.insertCell().textContent = new Date(pismeno.datum).toLocaleDateString('hr-HR');
            row.insertCell().textContent = pismeno.vrstaOpis;
            row.insertCell().textContent = pismeno.prilozi;
        });
    }

    function dodajDogadajNaPredmet() {
        if (!trenutniPredmetPodaci) {
            alert("Nije kreiran ili odabran predmet. Molimo prvo osnujte predmet.");
            return;
        }
        const datumVrijemeRaw = document.getElementById('noviDogadajDatum').value;
        const opis = document.getElementById('noviDogadajOpis').value.trim();

        if (!datumVrijemeRaw || !opis) {
            alert("Molimo unesite datum/vrijeme i opis događaja.");
            return;
        }
        const datumVrijeme = new Date(datumVrijemeRaw);
        const formatiranoDatumVrijeme = `${datumVrijeme.toLocaleDateString('hr-HR')} ${datumVrijeme.toLocaleTimeString('hr-HR', { hour: '2-digit', minute: '2-digit'})}`;

        dogadajiZaTrenutniPredmet.push({
            rbr: dogadajiCounter++,
            datumVrijeme: formatiranoDatumVrijeme, 
            opis
        });
        renderDogadajiNaPredmetu();
        document.getElementById('noviDogadajOpis').value = '';
    }
    function renderDogadajiNaPredmetu() {
        const tbody = document.getElementById('dogadajiNaPredmetuTable').getElementsByTagName('tbody')[0];
        tbody.innerHTML = "";
        dogadajiZaTrenutniPredmet.forEach(dogadaj => {
            const row = tbody.insertRow();
            row.insertCell().textContent = dogadaj.rbr;
            row.insertCell().textContent = dogadaj.datumVrijeme;
            row.insertCell().textContent = dogadaj.opis;
        });
    }

    // --- Funkcije za ispis ---
    function printDiv(divId, title) { /* ... ostaje isto ... */ 
        const divToPrint = document.getElementById(divId);
        if (divToPrint) {
            document.getElementById('printPreviewBodyGlobal').innerHTML = divToPrint.innerHTML;
            document.getElementById('printPreviewOverlayGlobal').classList.remove('hidden');
            document.body.classList.add('printing');
            const elementsToHide = document.querySelectorAll('body > *:not(#printPreviewOverlayGlobal)');
            elementsToHide.forEach(el => el.classList.add('hidden-for-print'));

        } else {
            alert("Element za ispis nije pronađen: " + divId);
        }
    }
    function closePrintPreviewGlobal() { /* ... ostaje isto ... */ 
        document.getElementById('printPreviewOverlayGlobal').classList.add('hidden');
        document.getElementById('printPreviewBodyGlobal').innerHTML = '';
        document.body.classList.remove('printing');
        const elementsToShow = document.querySelectorAll('.hidden-for-print');
        elementsToShow.forEach(el => el.classList.remove('hidden-for-print'));
    }
    const printStyle = document.createElement('style');
    printStyle.innerHTML = ` @media print { body.printing > *:not(#printPreviewOverlayGlobal), body.printing #printPreviewOverlayGlobal > div > *:not(#printPreviewBodyGlobal):not(.print-area-global), .no-print { display: none !important; } #printPreviewOverlayGlobal { position: static !important; width: auto !important; height: auto !important; overflow: visible !important; } #printPreviewBodyGlobal, .print-area-global { display: block !important; width: 100% !important; max-width: 100% !important; box-shadow: none !important; border: none !important; padding: 0 !important; margin: 0 !important; } } .hidden-for-print { display: none !important; } `;
    document.head.appendChild(printStyle);

